<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- INTERNET is required even to LISTEN on 127.0.0.1 loopback (the
         local link). ghosta makes no outbound connections; normal permission,
         granted at install, invisible to the user. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- Owner-setup capability for the decommission path ONLY. After ghostd is
         removed this accessibility service must open its own system uninstall
         sheet from the background; Android blocks background activity starts
         without an exemption, and "Display over other apps" is that exemption.
         It is requested during owner setup and never obtained or bypassed at
         runtime: `decommission prepare` fails with self_uninstall_blocked when
         it is not granted, before ghostd starts its own removal. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <!-- MainActivity has NO launcher filter: ghosta never shows an icon
             in the drawer at all. It is reachable via Settings → Apps and
             the accessibility settings page when needed. -->
        <activity
            android:name=".MainActivity"
            android:exported="true" />

        <service
            android:name=".GhostAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>

        <!-- system rebinds accessibility services after boot automatically;
             receiver just logs so the boot path is observable if needed. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
